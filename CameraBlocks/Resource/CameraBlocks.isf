/*{
  "DESCRIPTION": "4 movable square tiles. Each tile has its own OUTPUT center (where it is placed) and INPUT camera (center+zoom). Tile size grows/shrinks around the output center.",
  "CREDIT": "ChatGPT",
  "ISFVSN": "2",
  "CATEGORIES": [ "Transform", "Stylize" ],
  "INPUTS": [
    { "NAME": "inputImage", "TYPE": "image" },

    { "NAME": "tileSize", "TYPE": "float", "DEFAULT": 0.5, "MIN": 0.05, "MAX": 1.0, "LABEL": "Tile Size (fraction of min dimension)" },
    { "NAME": "border",   "TYPE": "float", "DEFAULT": 0.0, "MIN": 0.0,  "MAX": 0.2, "LABEL": "Border (relative to tile)" },

    { "NAME": "Tile_1_out", "TYPE": "point2D", "DEFAULT": [0.15, 0.85], "LABEL": "Tile 1 Output Center (UV)" },
    { "NAME": "Tile_2_out", "TYPE": "point2D", "DEFAULT": [0.85, 0.85], "LABEL": "Tile 2 Output Center (UV)" },
    { "NAME": "Tile_3_out", "TYPE": "point2D", "DEFAULT": [0.15, 0.15], "LABEL": "Tile 3 Output Center (UV)" },
    { "NAME": "Tile_4_out", "TYPE": "point2D", "DEFAULT": [0.85, 0.15], "LABEL": "Tile 4 Output Center (UV)" },

    { "NAME": "Tile_1_center", "TYPE": "point2D", "DEFAULT": [0.25, 0.25], "LABEL": "Tile 1 Camera Center (UV)" },
    { "NAME": "Tile_1_zoom",   "TYPE": "float",   "DEFAULT": 2.0, "MIN": 0.5, "MAX": 5.0, "LABEL": "Tile 1 Zoom" },

    { "NAME": "Tile_2_center", "TYPE": "point2D", "DEFAULT": [0.75, 0.25], "LABEL": "Tile 2 Camera Center (UV)" },
    { "NAME": "Tile_2_zoom",   "TYPE": "float",   "DEFAULT": 2.0, "MIN": 0.5, "MAX": 5.0, "LABEL": "Tile 2 Zoom" },

    { "NAME": "Tile_3_center", "TYPE": "point2D", "DEFAULT": [0.25, 0.75], "LABEL": "Tile 3 Camera Center (UV)" },
    { "NAME": "Tile_3_zoom",   "TYPE": "float",   "DEFAULT": 2.0, "MIN": 0.5, "MAX": 5.0, "LABEL": "Tile 3 Zoom" },

    { "NAME": "Tile_4_center", "TYPE": "point2D", "DEFAULT": [0.75, 0.75], "LABEL": "Tile 4 Camera Center (UV)" },
    { "NAME": "Tile_4_zoom",   "TYPE": "float",   "DEFAULT": 2.0, "MIN": 0.5, "MAX": 5.0, "LABEL": "Tile 4 Zoom" },

    { "NAME": "clampToEdges", "TYPE": "bool", "DEFAULT": true, "LABEL": "Clamp Camera UV to [0..1]" },
    { "NAME": "bgAlpha", "TYPE": "float", "DEFAULT": 0.0, "MIN": 0.0, "MAX": 1.0, "LABEL": "Background Alpha" }
  ]
}*/

vec2 clamp01(vec2 v) { return clamp(v, vec2(0.0), vec2(1.0)); }

// Map a local tile uv in [0..1]x[0..1] to input uv using a "camera":
// camera center in UV, and zoom where >1 means zoom in.
vec2 cameraUV(vec2 tileUV, vec2 centerUV, float zoom) {
    vec2 local = tileUV - vec2(0.5);        // [-0.5..0.5]
    vec2 uv = centerUV + local / max(zoom, 1e-6);
    return uv;
}

// 1.0 in the border region, 0.0 in the inner region, only meaningful if inside tile.
float borderMask(vec2 tileUV, float borderFrac) {
    float b = clamp(borderFrac, 0.0, 0.49);
    float inner =
        step(b, tileUV.x) * step(b, tileUV.y) *
        step(tileUV.x, 1.0 - b) * step(tileUV.y, 1.0 - b);
    return 1.0 - inner;
}

// Test if frag is inside a *pixel-square* tile whose UV extents differ by aspect.
// Given tile center in output UV and half-extents (tileSizeU/2, tileSizeV/2),
// return inside flag and local tileUV in [0..1].
float insideTileRect(vec2 fragUV, vec2 tileCenterUV, float tileSizeU, float tileSizeV, out vec2 outTileUV) {
    vec2 d = fragUV - tileCenterUV;
    float inside = step(abs(d.x), 0.5 * tileSizeU) * step(abs(d.y), 0.5 * tileSizeV);
    outTileUV = vec2(d.x / tileSizeU + 0.5, d.y / tileSizeV + 0.5);
    return inside;
}

void main() {
    vec2 uv = isf_FragNormCoord.xy;

    float w = RENDERSIZE.x;
    float h = RENDERSIZE.y;
    float minDim = min(w, h);

    // tileSize is fraction of min dimension -> pixels, then to UV in each axis
    float tilePx   = tileSize * minDim;
    float tileSizeU = tilePx / w;
    float tileSizeV = tilePx / h;

    vec4 outCol = vec4(0.0, 0.0, 0.0, bgAlpha);

    vec2 tileUV;
    float inside;
	
	// default: passthrough (full-frame)
	vec2 mainUV = uv;
    if (clampToEdges) mainUV = clamp01(mainUV);
    outCol = IMG_NORM_PIXEL(inputImage, mainUV);

    // ---- TL ----
    inside = insideTileRect(uv, Tile_1_out, tileSizeU, tileSizeV, tileUV);
    if (inside > 0.5) {
        vec2 sampUV = cameraUV(tileUV, Tile_1_center, Tile_1_zoom);
        if (clampToEdges) sampUV = clamp01(sampUV);
        vec4 c = IMG_NORM_PIXEL(inputImage, sampUV);
        float bmask = borderMask(tileUV, border);
        c.rgb = mix(c.rgb, vec3(0.0), bmask);
        outCol = c;
    }

    // ---- Tile 2 ----
    inside = insideTileRect(uv, Tile_2_out, tileSizeU, tileSizeV, tileUV);
    if (inside > 0.5) {
        vec2 sampUV = cameraUV(tileUV, Tile_2_center, Tile_2_zoom);
        if (clampToEdges) sampUV = clamp01(sampUV);
        vec4 c = IMG_NORM_PIXEL(inputImage, sampUV);
        float bmask = borderMask(tileUV, border);
        c.rgb = mix(c.rgb, vec3(0.0), bmask);
        outCol = c;
    }
	
	// ---- Tile 3 ----
    inside = insideTileRect(uv, Tile_3_out, tileSizeU, tileSizeV, tileUV);
    if (inside > 0.5) {
        vec2 sampUV = cameraUV(tileUV, Tile_3_center, Tile_3_zoom);
        if (clampToEdges) sampUV = clamp01(sampUV);
        vec4 c = IMG_NORM_PIXEL(inputImage, sampUV);
        float bmask = borderMask(tileUV, border);
        c.rgb = mix(c.rgb, vec3(0.0), bmask);
        outCol = c;
    }

    // ---- Tile 4 ----
    inside = insideTileRect(uv, Tile_4_out, tileSizeU, tileSizeV, tileUV);
    if (inside > 0.5) {
        vec2 sampUV = cameraUV(tileUV, Tile_4_center, Tile_4_zoom);
        if (clampToEdges) sampUV = clamp01(sampUV);
        vec4 c = IMG_NORM_PIXEL(inputImage, sampUV);
        float bmask = borderMask(tileUV, border);
        c.rgb = mix(c.rgb, vec3(0.0), bmask);
        outCol = c;
    }
    
    gl_FragColor = outCol;
}
